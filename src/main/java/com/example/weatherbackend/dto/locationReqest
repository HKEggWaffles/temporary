package com.example.weatherbackend.dto;

import jakarta.validation.constraints.DecimalMax;
import jakarta.validation.constraints.DecimalMin;
import jakarta.validation.constraints.NotBlank;
import jakarta.validation.constraints.NotNull;

public record FavLocationRequest(
    @NotBlank(message = "Please enter a city.")
    String city,

    @NotNull(message = "Please enter a country")
    String country,

    @NotNull(message = "Please enter latitude")
    @DecimalMin(value = "-90.0", message = "Please enter a valid latitude (>-90)")
    @DecimalMax(value = "90.0", message = "Please enter a valid latitude (<90)")
    Double lat,

    @NotNull(message = "Please enter longitude")
    @DecimalMin(value = "-180.0", message = "Please enter a valid longitude (>-180)")
    @DecimalMax(value = "180.0", message = "Please enter a valid longitude (<180)")
    Double lon
) {}